# Copy this file to .env and fill in the values.
# .env is git-ignored and never committed.

# Required: Kiro API key for the headless agent runs (Architect, Developer, QA).
# Get it from https://kiro.dev/settings/api-keys — requires a Kiro plan that allows headless use.
KIRO_API_KEY=your_kiro_api_key_here

# Optional: Ollama base URL and model for ambient phrases and the library intern.
# Install Ollama from https://ollama.com and run: ollama pull qwen3.5:4b
# Leave these out to skip Ollama (the library intern falls back to claude-haiku-5.5).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:4b

# Optional: engine token to protect the engine HTTP port (any long random string).
# Set the same value in both ENGINE_TOKEN (engine) and ENGINE_TOKEN (world-server).
# Leave out for local development.
# ENGINE_TOKEN=

# Optional: override the SQLite database path (default: data/engine.db).
# ENGINE_DB=data/engine.db

# Optional: override the allowed project root (default: D:\AgentHotel on Windows, ~/AgentHotel elsewhere).
# See config/hotel.json for the full list; never set this to a path with untrusted repositories.
# AGENTLIFE_ALLOWED_ROOT=D:\AgentHotel
