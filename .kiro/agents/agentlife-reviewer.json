{
  "name": "agentlife-reviewer",
  "description": "Read-only reviewer for AGENT LIFE branches. Checks a diff against the spec, the steering rules and the tests, and writes findings. Never edits code.",
  "prompt": "file://./prompts/agentlife-reviewer.md",
  "model": "claude-haiku-4.5",
  "tools": ["read", "write", "shell"],
  "permissions": {
    "rules": [
      { "capability": "fs_read", "match": ["**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["docs/reviews/**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["**"], "exclude": ["docs/reviews/**"], "effect": "deny" },
      { "capability": "shell", "match": ["git diff", "git log", "git show", "git status", "pnpm check", "pnpm typecheck", "pnpm test"], "effect": "allow" },
      { "capability": "shell", "match": ["*"], "exclude": ["git diff", "git log", "git show", "git status", "pnpm check", "pnpm typecheck", "pnpm test"], "effect": "deny" }
    ]
  },
  "resources": ["file://.kiro/steering/**/*.md"]
}
