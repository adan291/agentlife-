{
  "name": "agent-life",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit && tsc --noEmit -p scripts",
    "test": "pnpm -r test && vitest run --root scripts --passWithNoTests",
    "check": "pnpm typecheck && pnpm test",
    "session": "node --experimental-strip-types --no-warnings scripts/run-session.ts",
    "notify": "node --experimental-strip-types --no-warnings scripts/notify.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
